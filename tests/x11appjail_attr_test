        atf_fail "System attribute ${attr} already exists (cleanup routine failed?)."
    fi

    atf_check -s exit:0 x11appjail sys-attr put "${attr}" "${val}"
    atf_check -s exit:0 -o "inline:${val}\n" x11appjail sys-attr cat "${attr}"
    atf_check -s exit:0 -o save:list.out x11appjail sys-attr ls
    atf_check -s exit:0 -o "inline:${attr}\n" grep -Ee "^${attr_regex}$" list.out
    atf_check -s exit:0 x11appjail sys-attr check "${attr}"
    atf_check -s exit:0 x11appjail sys-attr rm "${attr}"
    atf_check -s not-exit:0 x11appjail sys-attr check "${attr}"
