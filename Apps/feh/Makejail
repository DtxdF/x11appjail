INCLUDE gh+AppJail-makejails/pkg-quick-conf
INCLUDE gh+AppJail-makejails/user-mapping
INCLUDE gh+AppJail-makejails/efficient-makejail

OPTION start
OPTION overwrite=force
OPTION type=thick
OPTION volume=data mountpoint:/noroot owner:${puid} group:${pgid}

CMD chown -Rh noroot:noroot /noroot
RAW packages=
RAW for package in feh xauth xrandr ratpoison xorg-fonts setxkbmap xdg-utils; do
        RAW if ! appjail pkg jail "${APPJAIL_JAILNAME}" info -e "${package}"; then
                RAW packages="${packages} ${package}"
        RAW fi
RAW done
RAW if [ -n "${packages}" ]; then
        PKG ${packages}
RAW fi
