INCLUDE gh+AppJail-makejail/pkg-quick-conf
INCLUDE gh+AppJail-makejails/user-mapping

OPTION start
OPTION overwrite=force
OPTION volume=data mountpoint:/noroot owner:${puid} group:${pgid}

# Without devices, this is useless.
CMD pw groupmod -n video -m noroot
CMD pw groupadd -n webcamd -g 145 -M noroot

CMD chown -Rh noroot:noroot /noroot
PKG librewolf dbus xauth xrandr ratpoison xorg-fonts mesa-dri mesa-libs

SERVICE dbus enable
SERVICE dbus start
