OPTION start
OPTION overwrite=force
OPTION alias
OPTION ip4_inherit
OPTION ip6_inherit
OPTION type=thick

COPY usr

SYSRC clear_tmp_X=NO

PKG thunderbird \
    dbus \
    xauth \
    xrandr \
    ratpoison \
    xorg-fonts \
    mesa-dri \
    mesa-libs \
    setxkbmap \
    xdg-utils \
    dunst \
    virtualgl
PKG --clean
CMD rm -rf /var/cache/pkg/*
CMD rm -rf /var/db/pkg/repos/*
