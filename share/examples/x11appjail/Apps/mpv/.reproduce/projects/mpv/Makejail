ARG va_deps?

OPTION start
OPTION overwrite=force
OPTION alias
OPTION ip4_inherit
OPTION ip6_inherit
OPTION type=thick

COPY usr

SYSRC clear_tmp_X=NO

PKG mpv \
    xauth \
    xrandr \
    ratpoison \
    xorg-fonts \
    setxkbmap \
    bash \
    mesa-libs \
    mesa-dri \
    virtualgl
RAW for dep in ${va_deps}; do
        PKG libva-${dep}
RAW done
PKG --clean
CMD rm -rf /var/cache/pkg/*
CMD rm -rf /var/db/pkg/repos/*
