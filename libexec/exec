test -n "${DOAS_USER}" || exit 1

UID=`id -u "${DOAS_USER}"` || exit 1
GID=`id -g "${DOAS_USER}"` || exit 1

load_common()
{
    local prefix
    prefix=`x11appjail prefix` || exit 1

    . "${prefix}/lib/x11appjail/common"
}

load_common

HOST_DISPLAY=":0"
HOST_DBUS_SYSTEM_BUS_ADDRESS="unix:path=/var/run/dbus/system_bus_socket"
HOST_DBUS_SESSION_BUS_ADDRESS=
HOST_OPTION=
HOST_INDEX=1

for HOST_OPTION; do
    case "${HOST_OPTION}" in
        display=*)
            HOST_DISPLAY="${HOST_OPTION#*=}"
            ;;
        dbus-system-bus-address=*)
            HOST_DBUS_SYSTEM_BUS_ADDRESS="${HOST_OPTION#*=}"
            ;;
        dbus-session-bus-address=*)
            HOST_DBUS_SESSION_BUS_ADDRESS="${HOST_OPTION#*=}"
            ;;
        --)
            HOST_INDEX=$((HOST_INDEX+1))
            break
            ;;
        *)
            warn "Ignoring unknown option '${HOST_OPTION}'"
            ;;
    esac

    HOST_INDEX=$((HOST_INDEX+1))
done
shift $((HOST_INDEX-1))

if ! check_display "${HOST_DISPLAY}"; then
    err "Invalid DISPLAY: ${HOST_DISPLAY}"
    exit 1
fi

build_appspec "$1"

shift

set -- -- "$@"

if [ -n "${HOST_DBUS_SESSION_BUS_ADDRESS}" ]; then
    set -- --set-option "dbus-session-bus-address=${HOST_DBUS_SESSION_BUS_ADDRESS}" "$@"
fi

set -- --set-option "display=${HOST_DISPLAY}" "$@"
set -- --set-option "profile=${PROFILE}" "$@"
set -- --set-option "uid=${UID}" "$@"
set -- --set-option "gid=${GID}" "$@"
set -- --set-option "dbus-system-bus-address=${HOST_DBUS_SYSTEM_BUS_ADDRESS}" "$@"

exec "/var/x11appjail/apps/${APPNAME}.${PROFILE}/START" "$@"
