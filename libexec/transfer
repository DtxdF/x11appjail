set -o pipefail

test -n "${DOAS_USER}" || exit 1

UID=`id -u "${DOAS_USER}"` || exit 1
GID=`id -g "${DOAS_USER}"` || exit 1
OGID=`id -G "${DOAS_USER}" | tr ' ' ','` || exit 1

load_common()
{
    local prefix
    prefix=`x11appjail prefix` || exit 1

    . "${prefix}/lib/x11appjail/common"
}

check_syntax1()
{
    printf "%s" "$1" | grep -qEe '^[^:]+:[^@]+@.*$'
}

check_syntax2()
{
    printf "%s" "$1" | grep -qEe '^[^:]+:.*$'
}

parse_syntax()
{
    _APPSPEC=
    _FILE=
    _APPNAME=
    _PROFILE=

    if check_syntax1 "$1"; then
        _APPSPEC=`printf "%s" "$1" | cut -d@ -f1` || exit 1
        _FILE=`printf "%s" "$1" | cut -d@ -f2-` || exit 1
    elif check_syntax2 "$1"; then
        _APPSPEC=`printf "%s" "$1" | cut -d: -f1` || exit 1
        _FILE=`printf "%s" "$1" | cut -d: -f2-` || exit 1

        if [ "${_APPSPEC}" = "<self>" ]; then
            unset _APPSPEC
        fi
    else
        _FILE="$1"
    fi

    if [ -n "${_APPSPEC}" ]; then
        build_appspec "${_APPSPEC}"

        _APPNAME="${APPNAME}"
        _PROFILE="${PROFILE}"
    fi
}

run_as()
{
    mdo -u "${UID}" -g "${GID}" -G "${OGID}" -- "$@"
}

load_common

FILE_MODE="$1"

test -n "${FILE_MODE}" || exit 1

FROM="$2"

test -n "${FROM}" || exit 1

parse_syntax "${FROM}"

FROM_APPSPEC="${_APPSPEC}"
FROM_FILE="${_FILE}"
FROM_APPNAME="${_APPNAME}"
FROM_PROFILE="${_PROFILE}"

if [ -z "${FROM_FILE}" ]; then
    err "Source file must be defined."
    exit 1
fi

TO="$3"

parse_syntax "${TO}"

TO_APPSPEC="${_APPSPEC}"
TO_FILE="${_FILE}"
TO_APPNAME="${_APPNAME}"
TO_PROFILE="${_PROFILE}"

if [ -z "${FROM_APPSPEC}" -a -z "${TO_APPSPEC}" ]; then
    err "Source must be defined."
    exit 1
fi

if [ -n "${TO_APPSPEC}" ] && [ -z "${TO_FILE}" ]; then
    TO_FILE=`basename -- "${FROM_FILE}"` || exit 1
fi

if [ -n "${FROM_APPSPEC}" -a -n "${FROM_FILE}" ]; then
    jtransfer -r \
        -u "${UID}:${GID}" \
        -j "x11appjail-${FROM_APPNAME}-${UID}_${FROM_PROFILE}" \
        -f "${FROM_FILE}" || exit 1
else
    run_as cat -- "${FROM_FILE}" || exit 1
fi |\
if [ -n "${TO_APPSPEC}" -a -n "${TO_FILE}" ]; then
    jtransfer -w \
        -m "${FILE_MODE}" \
        -u "${UID}:${GID}" \
        -j "x11appjail-${TO_APPNAME}-${UID}_${TO_PROFILE}" \
        -f "${TO_FILE}" || exit 1
elif [ -n "${TO_FILE}" ]; then
    run_as tee -- "${TO_FILE}" > /dev/null || exit 1
else
    cat || exit 1
fi
