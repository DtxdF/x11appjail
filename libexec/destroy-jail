test -n "${DOAS_USER}" || exit 1

UID=`id -u "${DOAS_USER}"` || exit 1
GID=`id -g "${DOAS_USER}"` || exit 1
OGID=`id -G "${UID}" | tr ' ' ','` || exit 1
PREFIX=`x11appjail prefix` || exit 1

load_common()
{
    . "${PREFIX}/lib/x11appjail/common"
}

load_common

build_appspec "$1"

shift

JAIL="x11appjail-${APPNAME}-${UID}_${PROFILE}"

CLEAN_SCRIPT="/var/run/x11appjail/clean/${JAIL}"

if [ -x "${CLEAN_SCRIPT}" ]; then
    env \
        X11APPJAIL_UID="${UID}" \
        X11APPJAIL_GID="${GID}" \
        X11APPJAIL_OGID="${OGID}" \
        X11APPJAIL_APPNAME="${APPNAME}" \
        X11APPJAIL_PROFILE="${PROFILE}" \
        X11APPJAIL_PREFIX="${PREFIX}" \
        "${CLEAN_SCRIPT}" || exit 1

    rm -f -- "${CLEAN_SCRIPT}"
fi

if appjail status -q -- "${JAIL}" > /dev/null 2>&1; then
    appjail stop -- "${JAIL}"
fi

appjail jail destroy -Rf -- "${JAIL}" > /dev/null 2>&1
